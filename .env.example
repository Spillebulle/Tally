# Tally configuration. Copy to .env — docker compose reads it automatically.
# Every value here is optional except PUBLIC_URL, which you should set.

# The URL you actually type in the browser to reach Tally. Plex sends you back
# here after sign-in, so a wrong value breaks the login flow.
# Examples: http://192.168.1.50:8080 or https://tally.example.com
PUBLIC_URL=http://localhost:8080

# --- Metadata providers (all optional) --------------------------------------
# Tally works with none of these — it falls back to the artwork your Plex
# server already has, and uses Jikan (no credentials) for anime.

# Posters, backdrops and descriptions. The single biggest visual improvement.
# Free key: https://www.themoviedb.org/settings/api (v3 key or v4 bearer token)
TMDB_API_KEY=

# Extra series data and the explicit "Anime" genre that TMDB lacks.
# Free key: https://thetvdb.com/api-information
TVDB_API_KEY=

# Official MyAnimeList API. Leave blank to use Jikan, the free MAL mirror.
MAL_CLIENT_ID=

# --- Behaviour ---------------------------------------------------------------
SYNC_INTERVAL_MINUTES=30
SESSIONS_POLL_SECONDS=30

# INFO, or DEBUG when something is not syncing and you want to see why.
LOG_LEVEL=INFO

# Timezone for logs and daily stats grouping.
TZ=UTC

# --- Security ----------------------------------------------------------------
# Signs sessions and encrypts stored Plex tokens at rest. Left blank, one is
# generated into /data/.secret_key on first boot — which is fine for most
# people. Set it to a long random string if you want sessions and stored Plex
# tokens to survive rebuilding from an empty /data.
# Generate one with: openssl rand -base64 48
# Changing it later logs everyone out and forces each user to re-link Plex.
SECRET_KEY=

# --- File ownership ----------------------------------------------------------
# Set these to the owner of your ./data directory (`id -u` and `id -g`) if the
# container cannot write to it. Defaults to 1000:1000.
#PUID=1000
#PGID=1000
